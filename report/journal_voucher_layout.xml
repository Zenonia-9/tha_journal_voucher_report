<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="tpc_journal_voucher_header">
        <t t-set="letterhead" t-value="o.env.ref('tha_journal_voucher_report.attachment_tpc_journal_voucher_header', raise_if_not_found=False)"/>
        <img t-if="letterhead and letterhead.datas"
             t-att-src="image_data_uri(letterhead.datas)"
             style="display: block; width: 100%; height: auto;"
             alt="TPC Header"/>
    </template>

    <template id="journal_voucher_layout_a4">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <div t-attf-class="header o_company_#{company.id}_layout">
            <t t-call="tha_journal_voucher_report.tpc_journal_voucher_header"/>
        </div>

        <div t-attf-class="article o_report_layout_standard o_table_standard o_company_#{company.id}_layout"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout">
            <div class="o_footer_content"/>
        </div>
    </template>

    <template id="journal_voucher_layout_a5">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <div t-attf-class="header o_company_#{company.id}_layout">
            <t t-call="tha_journal_voucher_report.tpc_journal_voucher_header"/>
        </div>

        <div t-attf-class="article o_report_layout_standard o_table_standard o_company_#{company.id}_layout"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout">
            <div class="o_footer_content"/>
        </div>
    </template>
</odoo>
