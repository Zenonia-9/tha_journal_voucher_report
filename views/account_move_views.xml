<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_journal_voucher_print" model="ir.ui.view">
        <field name="name">account.move.form.journal.voucher.print</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="after">
                <button name="action_open_journal_voucher_print_wizard"
                        string="Print"
                        type="object"
                        class="btn btn-secondary"
                        invisible="move_type != 'entry' or state != 'posted'"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_journal_voucher_print" model="ir.ui.view">
        <field name="name">account.move.list.journal.voucher.print</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='company_currency_id']" position="before">
                <header>
                    <!-- Batch print selected journal entries through the original wizard. -->
                    <button name="action_open_journal_voucher_print_wizard"
                            type="object"
                            string="Print JV"
                            groups="account.group_account_invoice"
                            invisible="context.get('default_move_type') != 'entry'"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
